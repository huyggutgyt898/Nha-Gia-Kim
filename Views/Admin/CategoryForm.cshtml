@model Nha_Gia_Kim.Models.ViewModels.AdminCategoryFormViewModel
@{
    Layout = "_AdminLayout";
    var isEditing = Model.Id.HasValue;
    ViewData["Title"] = isEditing ? "Sửa thể loại" : "Thêm thể loại";
}

<header class="admin-page-heading">
    <div>
        <a class="admin-back-link" asp-controller="AdminManagement" asp-action="Content" asp-route-tab="categories">← Quay lại nội dung</a>
        <p class="admin-eyebrow">DANH MỤC CỬA HÀNG</p>
        <h1>@(isEditing ? "Sửa thể loại" : "Thêm thể loại")</h1>
        <p>Đường dẫn thân thiện sẽ được cập nhật theo tên thể loại.</p>
    </div>
</header>

<div class="admin-form-wrap">
    <section class="admin-panel admin-form-panel">
        <form asp-controller="AdminManagement" asp-action="@(isEditing ? "EditCategory" : "NewCategory")"
              asp-route-id="@Model.Id" method="post" asp-antiforgery="true">
            <div asp-validation-summary="All" class="admin-validation-summary" role="alert"></div>
            <div class="admin-field">
                <label asp-for="Name">Tên thể loại <span class="required">*</span></label>
                <input asp-for="Name" autocomplete="off" />
                <span asp-validation-for="Name" class="admin-field-validation"></span>
            </div>
            <div class="admin-form-actions">
                <button class="admin-button admin-button-primary" type="submit">@(isEditing ? "Lưu thay đổi" : "Thêm thể loại")</button>
                <a class="admin-button" asp-controller="AdminManagement" asp-action="Content" asp-route-tab="categories">Hủy</a>
            </div>
        </form>
    </section>
</div>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Nhà Giả Kim</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-page">
    @{
        var showAdminShell = ViewData["ShowAdminShell"] as bool? == true;
        var activeAdminSection = ViewData["AdminSection"] as string;
        var adminDisplayName = string.IsNullOrWhiteSpace(User.Identity?.Name)
            ? "Quản trị viên"
            : User.Identity.Name!;
    }
    @if (showAdminShell)
    {
        <svg class="admin-icon-definitions" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
            <symbol id="admin-icon-orders" viewBox="0 0 24 24"><path d="M5 8h14l1 13H4L5 8Z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></symbol>
            <symbol id="admin-icon-books" viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 1 4 17.5z" /><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20M8 7h8" /></symbol>
            <symbol id="admin-icon-feedback" viewBox="0 0 24 24"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.7 8.7 0 0 1-3.5-.7L4 20l1.4-3.8A7.1 7.1 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5Z" /><path d="M8 11h8M8 14h5" /></symbol>
            <symbol id="admin-icon-logout" viewBox="0 0 24 24"><path d="M10 17l5-5-5-5M15 12H3M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" /></symbol>
        </svg>
        <div class="admin-app-shell">
            <header class="admin-header">
                <a class="admin-brand" asp-controller="Home" asp-action="Index" aria-label="Tiệm sách Nhà Giả Kim">
                    <span class="admin-brand-mark" aria-hidden="true">N</span>
                    <span>Tiệm sách <strong>Nhà Giả Kim</strong></span>
                </a>
                <div class="admin-account">
                    <span class="admin-account-name">@adminDisplayName</span>
                    <span class="admin-role">Admin</span>
                    <form asp-controller="Admin" asp-action="Logout" method="post">
                        <button class="admin-button admin-button-ghost" type="submit">Đăng xuất</button>
                    </form>
                </div>
            </header>
            <div class="admin-app-content">
                <aside class="admin-sidebar">
                    <p class="admin-nav-label">Cửa hàng</p>
                    <nav aria-label="Điều hướng quản trị">
                        <a class="@(activeAdminSection == "orders" ? "is-current" : null)"
                           aria-current="@(activeAdminSection == "orders" ? "page" : null)"
                           asp-controller="Admin" asp-action="Orders">
                            <svg aria-hidden="true"><use href="#admin-icon-orders" /></svg><span>Đơn hàng</span>
                        </a>
                        <a class="@(activeAdminSection == "books" ? "is-current" : null)"
                           aria-current="@(activeAdminSection == "books" ? "page" : null)"
                           asp-controller="AdminManagement" asp-action="Books">
                            <svg aria-hidden="true"><use href="#admin-icon-books" /></svg><span>Sách</span>
                        </a>
                        <a class="@(activeAdminSection == "feedback" ? "is-current" : null)"
                           aria-current="@(activeAdminSection == "feedback" ? "page" : null)"
                           asp-controller="Admin" asp-action="Feedback">
                            <svg aria-hidden="true"><use href="#admin-icon-feedback" /></svg><span>Phản hồi</span>
                        </a>
                    </nav>
                    <div class="admin-sidebar-account">
                        <span class="admin-avatar" aria-hidden="true">@adminDisplayName[..1]</span>
                        <span><strong>@adminDisplayName</strong><small>Tài khoản quản trị</small></span>
                    </div>
                </aside>
                <main class="admin-main">
                    @if (TempData["AdminNotice"] is string notice)
                    {
                        <p class="admin-notice" role="status">@notice</p>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

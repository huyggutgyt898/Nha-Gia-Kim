# Set this to a reachable SQL Server connection string before starting Docker Compose.
ConnectionStrings__DefaultConnection=

# Set these only when creating the first administrator in an empty Users table.
Admin__InitialUsername=
Admin__InitialPassword=
Admin__InitialFullName=

# Optional SMTP settings for order confirmation emails.
Email__Smtp__Host=
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromAddress=
Email__Smtp__FromName=Nhà Giả Kim
